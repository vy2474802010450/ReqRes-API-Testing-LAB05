          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Name matches CSV data\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.name).to.eql(\r",
                  "        pm.iterationData.get(\"name\")\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Job matches CSV data\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.job).to.eql(\r",
                  "        pm.iterationData.get(\"job\")\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Save userId\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.id).to.exist;\r",
                  "    pm.environment.set(\"userId\", jsonData.id);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
